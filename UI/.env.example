# Paddle and Supabase settings for the api/ functions. Set them in Vercel > Project > Settings >
# Environment Variables. For local testing, copy this file to .env.local and run `node dev-server.js`.

# Required: "sandbox" or "production". The site refuses to load prices if unset.
PADDLE_ENV=sandbox
# Client-side token (test_... for sandbox, live_... for production). Never put an API key here.
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Server-only API key (pdl_sdbx_... in sandbox). Give it only these permissions:
# subscription.read, transaction.read, customer_portal_session.write.
PADDLE_API_KEY=
# Secret key of the Paddle notification destination for /api/paddle-webhook (pdl_ntfset_...).
PADDLE_WEBHOOK_SECRET=
# Supabase secret key (sb_secret_...) or legacy service_role key. Server only: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
# PostHog project key (phc_...) for web app session replay, EU project. Public by design; served by /api/posthog-config.
POSTHOG_PROJECT_KEY=
