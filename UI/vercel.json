{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/account",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/pricing.html",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard_(.+)",
      "destination": "/dashboard"
    },
    {
      "source": "/app/:path*",
      "destination": "/app"
    }
  ]
}
