{
  "cleanUrls": true,
  "functions": {
    "api/gemini.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/account",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/pricing.html",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard_(.+)",
      "destination": "/dashboard"
    },
    {
      "source": "/app/:path*",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
